<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:TaskFlow.Core;assembly=TaskFlow.Core"
             xmlns:vm="clr-namespace:TaskFlow.Core.ViewModels;assembly=TaskFlow.Core"
             xmlns:local="clr-namespace:TaskFlow.Maui"
             x:Class="TaskFlow.Maui.TaskListPage"
             x:DataType="vm:TaskListViewModel"
             Title="TaskFlow">

    <ContentPage.Resources>
        <local:HexColorConverter x:Key="HexColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16,12,16,12" RowSpacing="12">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="TaskFlow" FontSize="28" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}" />
            <Label Text="{Binding PlatformLabel}" FontSize="13"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </VerticalStackLayout>

        <!-- Progress card -->
        <Border Grid.Row="1" StrokeThickness="0" Padding="16"
                BackgroundColor="{AppThemeBinding Light=#E0E7FF, Dark=#312E81}">
            <Border.StrokeShape>
                <RoundedRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Stats.Summary}" FontSize="17" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />
                <ProgressBar Progress="{Binding Stats.Progress}"
                             ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource Pill}" BackgroundColor="#264F46E5">
                        <Label Text="{Binding Stats.ActiveText}" Style="{StaticResource PillLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" BackgroundColor="#26F5A524">
                        <Label Text="{Binding Stats.DueTodayText}" Style="{StaticResource PillLabel}" TextColor="#F5A524" />
                    </Border>
                    <Border Style="{StaticResource Pill}" BackgroundColor="#26E5484D">
                        <Label Text="{Binding Stats.OverdueText}" Style="{StaticResource PillLabel}" TextColor="#E5484D" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Search -->
        <SearchBar Grid.Row="2" Text="{Binding Query}" Placeholder="Search tasks or tags" />

        <!-- Filters -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="All" Style="{StaticResource FilterButton}"
                    Command="{Binding SetFilterCommand}" CommandParameter="All">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAllSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#1E1B4B}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Active" Style="{StaticResource FilterButton}"
                    Command="{Binding SetFilterCommand}" CommandParameter="Active">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsActiveSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#1E1B4B}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Done" Style="{StaticResource FilterButton}"
                    Command="{Binding SetFilterCommand}" CommandParameter="Done">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsDoneSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#1E1B4B}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Tasks -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Tasks}" SelectionMode="None"
                        EmptyView="Nothing here. Enjoy the calm.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:TaskRow">
                    <Border Margin="0,0,0,10" Padding="4,8,4,8" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#F1F3F9, Dark=#171A22}">
                        <Border.StrokeShape>
                            <RoundedRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <CheckBox Grid.Column="0" VerticalOptions="Center"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      CheckedChanged="OnTaskCheckedChanged"
                                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="16" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="#9CA3AF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                             Fill="{Binding PriorityColor, Converter={StaticResource HexColor}}" />
                                    <Label Text="{Binding PriorityLabel}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                                    <Label Text="{Binding TagText}" FontSize="12" IsVisible="{Binding HasTag}"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Label Text="{Binding DueText}" FontSize="12"
                                           TextColor="{Binding DueColor, Converter={StaticResource HexColor}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="✕" Clicked="OnDeleteClicked"
                                    BackgroundColor="Transparent" TextColor="#9CA3AF"
                                    FontSize="16" WidthRequest="44" HeightRequest="44" Padding="0"
                                    SemanticProperties.Description="Delete task" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Quick add -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding NewTitle}" Placeholder="New task…"
                   ReturnCommand="{Binding AddCommand}" />
            <Picker Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority}"
                    WidthRequest="96" Title="Priority" />
            <Button Grid.Column="2" Text="Add" Command="{Binding AddCommand}" CornerRadius="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light=White, Dark=#1E1B4B}" />
        </Grid>
    </Grid>
</ContentPage>
